{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": true,
   "escape_key_behavior": "close_window",
   "favicon_service": "twenty",
   "font": {
      "rendering": "qt",
      "normal": {
         "family": "Geist",
         "size": 12
      }
   },
   "theme": {
      "dark": {
         "name": "zenwritten-dark",
         "icon_theme": "MacTahoe-dark"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "rounding": 16,
      "opacity": 0.6,
      "client_side_decorations": {
         "enabled": true,
         "border_width": 0,
         "shadow_size": 15
      },
      "size": {
         "width": 770,
         "height": 580
      },
      "compact_mode": {
         "enabled": false
      },
      "layer_shell": {
         "enabled": false
      }
   },
   "keybinds": {
      "toggle-action-panel": "control+RETURN"
   },
   "providers": {
      "@Keyruu/store.raycast.zen-browser": {
         "enabled": false
      },
      "@dagimg-dot/store.vicinae.player-pilot": {
         "entrypoints": {
            "pause-track": {
               "enabled": true
            },
