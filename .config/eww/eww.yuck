;; ==========================================
;; VARIABLES
;; ==========================================

;; Laptop monitor
(defvar windows_eDP-1 "[]")

;; External monitor
(defvar windows_HDMI-A-1 "[]")


;; ==========================================
;; WIDGETS
;; ==========================================

(defwidget tab [w]
  (button :class {w.active ? "tab active" : "tab"}
          :onclick "hyprctl dispatch \"hl.dsp.focus({ window = 'address:${w.address}' })\""
          :onrightclick "hyprctl dispatch \"hl.dsp.window.close({ window = 'address:${w.address}' })\""
    (box :orientation "h"
         :spacing 6
         :space-evenly false
         :halign "center"
         :valign "center"

      (image :class "tab-icon"
             :icon {w.icon}
             :icon-size "small-toolbar")

      (label :class "tab-label"
             :text {w.title}
             :limit-width 100
             :ellipsize "end"
             :single-line true))))


(defwidget tabbar [tabs]
  (box :class "tabbar"
       :orientation "h"
       :space-evenly true
       :spacing 1

    ;; Loop through the tabs passed from the specific monitor
    (for w in tabs
      (tab :w w))))


;; ==========================================
;; WINDOW DEFINITIONS
;; ==========================================

;; 1. Laptop Monitor (eDP-1)
(defwindow tabbar_eDP-1
  :monitor "eDP-1"
  :windowtype "dock"
  :exclusive true
  :stacking "fg"
  :geometry (geometry
              :x "0"
              :y "0"
              :width "100%"
              :height "30px"
              :anchor "bottom center")
  (tabbar :tabs windows_eDP-1))


;; 2. External Monitor (HDMI-A-1)
(defwindow tabbar_HDMI-A-1
  :monitor "HDMI-A-1"
  :windowtype "dock"
  :exclusive true
  :stacking "fg"
  :geometry (geometry
              :x "0"
              :y "0"
              :width "100%"
              :height "30px"
              :anchor "bottom center")
  (tabbar :tabs windows_HDMI-A-1))
