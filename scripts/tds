#!/usr/bin/env bash

# --- Upfront Dependency Validation ---
for cmd in tmux jq; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required tool '$cmd' is not installed." >&2
        exit 1
    fi
done

# ==============================================================================
# CONFIGURATION MANAGEMENT (JSON & PROFILES)
# ==============================================================================
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tds"
CONFIG_FILE="$CONFIG_DIR/config.json"
PROFILES_DIR="$CONFIG_DIR/profiles"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tds"
HIST_FILE="$CACHE_DIR/history"
MANAGED_FILTER='#{==:#{@tds_managed},1}'

# Auto-create config directory and config.json if they don't exist
if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR" "$PROFILES_DIR"
    cat <<EOF >"$CONFIG_FILE"
{
  "search_paths": [
    "~/projects"
  ]
}
EOF
fi

# Ensure profiles directory exists
mkdir -p "$PROFILES_DIR"

# Load SEARCH_PATHS dynamically from config.json
SEARCH_PATHS=()
while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    # Expand tilde (~) and environment variables safely
    eval path="$path"
    SEARCH_PATHS+=("$path")
done < <(jq -r '.search_paths[]? // empty' "$CONFIG_FILE" 2>/dev/null)

DEFAULT_PROFILE=$(jq -r '.default_profile // empty' "$CONFIG_FILE" 2>/dev/null)

YAZI_MODE=false
FIND_MODE=false
HIST_MODE=false
EDITOR_CMD=""
profile_name=""
PROFILE_EXPLICITLY_SET=false
PROFILE_PICK=false
NO_PROFILE=false
LIST_MODE=false
DOCTOR_MODE=false
SESSIONS_MODE=false
KILL_TARGET=""
RECREATE=false
target=""

# --- Help Menu ---
print_help() {
    cat <<EOF
Usage: tds [DIRECTORY] [OPTIONS]

A project-focused development workspace launcher with automatic history tracking, 
extensible editor integration, and modular window layout profiles.

Configuration:
  JSON Config File:   $CONFIG_FILE
  Profiles Directory: $PROFILES_DIR

Arguments:
  DIRECTORY             Path to a specific project directory to open. 
                        If omitted, opens the current directory by default.

Selection Options:
  -H, --history         Open fzf to pick from recent project history.
  -f, --find            Deterministically scan search paths and submodules using fzf.
  -y, --yazi            Open the Yazi file manager to interactively select a directory.
  -s, --sessions        Pick from running tmux sessions with fzf.

Workspace Options:
  -p, --profile <name>  Use a specific window layout profile. Overrides default_profile.
  -P, --select-profile  Pick the profile with fzf. Rebuilds the session if it exists.
      --no-profile      Ignore any profile and use the single-window layout.

Session Options:
  -l, --list            List tmux sessions.
  -k, --kill <name|dir> Kill a session by name, or the session for a directory.
      --recreate        Kill and rebuild the session so a changed profile takes effect.
      --doctor          Check config, profiles and managed sessions.

Editor Options:
  -c, --code            Open project with standalone VS Code ('code')
  -i, --idea            Open project with IntelliJ IDEA ('idea')
  -e, --editor <cmd>    Open project with any custom editor/tool command

Utility Options:
  --clean               Clear the recent project history cache.
  -h, --help            Display this help message and exit.

Examples:
  tds                   # Open current directory with fallback 1-window layout
  tds -f -p backend     # Select project via fzf and apply 'backend' profile explicitly
  tds ./my-app          # Open specific path with fallback 1-window layout
  tds -H                # Pick a project from recent history via fzf
  tds --clean           # Clear the history cache
  tds -l                # List tmux sessions
  tds -k .              # Kill the session for the current directory
  tds -f -p dev --recreate  # Rebuild the picked project's session with the dev profile
EOF
    exit 0
}

# --- History Management Function (with 50-entry cap) ---
add_to_history() {
    local dir="$1"
    mkdir -p "$CACHE_DIR"

    # Remove existing entry if present to avoid duplicates
    if [[ -f "$HIST_FILE" ]]; then
        grep -vxF "$dir" "$HIST_FILE" >"${HIST_FILE}.tmp" 2>/dev/null || true
        mv "${HIST_FILE}.tmp" "$HIST_FILE"
    fi

    # Prepend the new path to the top of the history file
    (
        echo "$dir"
        cat "$HIST_FILE" 2>/dev/null
    ) >"${HIST_FILE}.tmp"
    mv "${HIST_FILE}.tmp" "$HIST_FILE"

    # Cap history file to a maximum of 50 entries
    if [[ -f "$HIST_FILE" ]]; then
        head -n 50 "$HIST_FILE" >"${HIST_FILE}.tmp"
        mv "${HIST_FILE}.tmp" "$HIST_FILE"
    fi
}

# --- Short 4-Char Hash Session Naming ---
session_name_for() {
    local path="$1"
    local base_name hash
    base_name=$(basename "$path" | tr . _)
    hash=$(printf "%s" "$path" | md5sum | cut -c1-4)
    printf '%s-%s' "$base_name" "$hash"
}

is_project_dir() {
    local p
    for p in "${SEARCH_PATHS[@]}"; do
        [[ "$(dirname "$1")" == "${p%/}" ]] && return 0
    done
    return 1
}

# Reads directories on stdin, prints "<dir><TAB><label><session/profile info>" for fzf.
# With "short": label is the basename (full path on name collision) and $PWD is skipped.
project_rows() {
    local short="${1:-}" name prof dir label shown
    declare -A session_profile=()
    while IFS=$'\t' read -r name prof; do
        session_profile["$name"]="$prof"
    done < <(tmux list-sessions -f "$MANAGED_FILTER" -F $'#{session_name}\t#{@tds_profile}' 2>/dev/null)

    local -a dirs=()
    mapfile -t dirs
    for dir in "${dirs[@]}"; do
        shown="$dir"
        if [[ -n "$short" ]]; then
            if is_project_dir "$dir"; then
                shown="${dir##*/}"
            else
                shown="${dir/#$HOME\//\~/}"
            fi
        fi
        label=""
        name=$(session_name_for "$dir")
        if [[ -v session_profile[$name] ]]; then
            label="   [session: $name | profile: ${session_profile[$name]:--}]"
        fi
        printf '%s\t%s%s\n' "$dir" "$shown" "$label"
    done
}

# --- Parse arguments ---
while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
        print_help
        ;;
    --doctor)
        DOCTOR_MODE=true
        shift
        ;;
    --clean)
        if [[ -f "$HIST_FILE" ]]; then
            rm -f "$HIST_FILE"
            echo "Project history cache cleared successfully."
        else
            echo "No history cache found."
        fi
        exit 0
        ;;
    -H | --history)
        HIST_MODE=true
        shift
        ;;
    -f | --find)
        FIND_MODE=true
        shift
        ;;
    -y | --yazi)
        YAZI_MODE=true
        shift
        ;;
    -s | --sessions)
        SESSIONS_MODE=true
        shift
        ;;
    -p | --profile)
        profile_name="$2"
        PROFILE_EXPLICITLY_SET=true
        shift 2
        ;;
    -P | --select-profile)
        PROFILE_PICK=true
        shift
        ;;
    --no-profile)
        NO_PROFILE=true
        shift
        ;;
    -l | --list)
        LIST_MODE=true
        shift
        ;;
    -k | --kill)
        if [[ -z "$2" ]]; then
            echo "Error: --kill requires a session name or directory." >&2
            exit 1
        fi
        KILL_TARGET="$2"
        shift 2
        ;;
    --recreate)
        RECREATE=true
        shift
        ;;
    -c | --code)
        EDITOR_CMD="code"
        shift
        ;;
    -i | --idea)
        EDITOR_CMD="idea"
        shift
        ;;
    -e | --editor)
        EDITOR_CMD="$2"
        shift 2
        ;;
    -*)
        echo "Unknown option: $1" >&2
        echo "Run 'tds --help' for usage." >&2
        exit 1
        ;;
    *)
        target="$1"
        shift
        ;;
    esac
done

# --- Session Management (list / kill, no profile or directory selection needed) ---
if [[ "$LIST_MODE" == "true" ]]; then
    tmux list-sessions -f "$MANAGED_FILTER" -F '#{session_name}  #{session_windows}w  #{?session_attached,attached,detached}  #{session_path}' 2>/dev/null || echo "No tds sessions."
    exit 0
fi

if [[ -n "$KILL_TARGET" ]]; then
    kill_name="$KILL_TARGET"
    if [[ -d "$KILL_TARGET" ]]; then
        kill_name=$(session_name_for "$(cd "$KILL_TARGET" && pwd)")
    fi
    if ! tmux list-sessions -f "$MANAGED_FILTER" -F '#{session_name}' | grep -qxF -- "$kill_name"; then
        echo "Error: '$kill_name' is not a tds session." >&2
        exit 1
    fi
    tmux kill-session -t "=$kill_name" || exit 1
    echo "Killed session '$kill_name'."
    exit 0
fi

# --- Resolve Profile (-p > default_profile > built-in single-window layout) ---
profile_is_valid() {
    jq -e '.windows | type == "array"' "$1" &>/dev/null
}

pick_profile() {
    local name="$1" default_profile pref_profile pref_marker chosen
    default_profile=${DEFAULT_PROFILE:-basic}
    pref_profile="$default_profile"
    pref_marker="Default"
    if tmux list-sessions -f "$MANAGED_FILTER" -F '#{session_name}' | grep -qxF -- "$name"; then
        pref_profile=$(tmux display-message -p -t "=$name:" '#{@tds_profile}')
        pref_profile=${pref_profile:-basic}
        pref_marker="Current"
    fi
    chosen=$({
        if [[ "$pref_marker" == "Current" ]]; then
            printf '%s\t[Current: %s]\n' "$pref_profile" "$pref_profile"
        fi
        printf '%s\t[Default: %s]\n' "$default_profile" "$default_profile"
        { echo basic; find "$PROFILES_DIR" -maxdepth 1 -name '*.json' -exec basename {} .json \; ; } | sort -u |
            while IFS= read -r p; do
                [[ "$p" == "$pref_profile" || "$p" == "$default_profile" ]] || printf '%s\t%s\n' "$p" "$p"
            done
    } | fzf --no-sort --delimiter=$'\t' --with-nth=2.. \
        --prompt="󰒓 Profile > " --border-label " 󰒓 Profiles " | cut -f1)
    [[ -n "$chosen" ]] || return 1
    PROFILE_EXPLICITLY_SET=true
    if [[ "$chosen" == "basic" ]]; then
        PROFILE_FILE=""
    else
        PROFILE_FILE="$PROFILES_DIR/$chosen.json"
    fi
}

run_doctor() {
    local status=0 name prof path p f
    doc_ok() { printf 'OK    %s\n' "$*"; }
    doc_warn() { printf 'WARN  %s\n' "$*"; }
    doc_err() {
        printf 'ERR   %s\n' "$*"
        status=1
    }

    for cmd in tmux jq fzf; do
        if command -v "$cmd" &>/dev/null; then doc_ok "$cmd found"; else doc_err "$cmd is not installed"; fi
    done

    if jq -e . "$CONFIG_FILE" &>/dev/null; then
        doc_ok "config parses: $CONFIG_FILE"
    else
        doc_err "config is not valid JSON: $CONFIG_FILE"
    fi
    if [[ ${#SEARCH_PATHS[@]} -eq 0 ]]; then doc_warn "no search_paths configured"; fi
    for p in "${SEARCH_PATHS[@]}"; do
        if [[ -d "$p" ]]; then doc_ok "search path exists: $p"; else doc_warn "search path missing: $p"; fi
    done

    local found_profile=false
    for f in "$PROFILES_DIR"/*.json; do
        [[ -e "$f" ]] || break
        found_profile=true
        if profile_is_valid "$f"; then
            doc_ok "profile valid: $(basename "$f" .json)"
        else
            doc_err "profile invalid (no windows array): $f"
        fi
    done
    [[ "$found_profile" == "true" ]] || doc_warn "no profiles in $PROFILES_DIR"

    if [[ -n "$DEFAULT_PROFILE" ]]; then
        if [[ -f "$PROFILES_DIR/$DEFAULT_PROFILE.json" ]] && profile_is_valid "$PROFILES_DIR/$DEFAULT_PROFILE.json"; then
            doc_ok "default_profile '$DEFAULT_PROFILE' is valid"
        else
            doc_err "default_profile '$DEFAULT_PROFILE' is missing or invalid"
        fi
    fi

    while IFS=$'\t' read -r name prof path; do
        [[ -n "$name" ]] || continue
        if [[ -d "$path" ]]; then
            doc_ok "session $name -> $path"
        else
            doc_warn "session $name: directory is missing: $path"
        fi
        if [[ -n "$prof" && "$prof" != "basic" && ! -f "$PROFILES_DIR/$prof.json" ]]; then
            doc_warn "session $name: profile '$prof' no longer exists"
        fi
    done < <(tmux list-sessions -f "$MANAGED_FILTER" -F $'#{session_name}\t#{@tds_profile}\t#{session_path}' 2>/dev/null)

    return $status
}

if [[ "$DOCTOR_MODE" == "true" ]]; then
    run_doctor
    exit $?
fi

PROFILE_FILE=""
if [[ "$NO_PROFILE" != "true" ]]; then
    if [[ "$PROFILE_EXPLICITLY_SET" == "true" ]]; then
        PROFILE_FILE="$PROFILES_DIR/${profile_name}.json"
        if [[ ! -f "$PROFILE_FILE" ]]; then
            echo "Error: Profile '$profile_name' specified via CLI was not found at $PROFILE_FILE" >&2
            exit 1
        fi
        if ! profile_is_valid "$PROFILE_FILE"; then
            echo "Error: Profile '$profile_name' is invalid (expected a 'windows' array)." >&2
            exit 1
        fi
    elif [[ -n "$DEFAULT_PROFILE" ]]; then
        PROFILE_FILE="$PROFILES_DIR/${DEFAULT_PROFILE}.json"
        if [[ ! -f "$PROFILE_FILE" ]] || ! profile_is_valid "$PROFILE_FILE"; then
            echo "Warning: default_profile '$DEFAULT_PROFILE' is missing or invalid; using single-window layout." >&2
            PROFILE_FILE=""
        fi
    fi
fi

# --- Determine target directory ---
if [[ "$HIST_MODE" == "true" ]]; then
    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is required for --history mode." >&2
        exit 1
    fi
    if [[ ! -f "$HIST_FILE" ]]; then
        echo "No history cache found." >&2
        exit 1
    fi
    target=$(project_rows <"$HIST_FILE" | fzf --delimiter=$'\t' --with-nth=2.. --prompt="󰉋 Recent Dev Projects > " | cut -f1)
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        exit 0
    fi
elif [[ "$FIND_MODE" == "true" ]]; then
    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is required for --find mode." >&2
        exit 1
    fi
    if [ ${#SEARCH_PATHS[@]} -eq 0 ]; then
        echo "Error: No search paths defined in $CONFIG_FILE" >&2
        exit 1
    fi

    label_text="Projects & Submodules"
    [[ -n "$PROFILE_FILE" ]] && label_text="Projects (Profile: $(basename "$PROFILE_FILE" .json))"

    # Deterministically scan SEARCH_PATHS up to depth 1, sort alphabetically, and ignore hidden folders
    list_projects() {
        local listed here mark="" managed path
        here="$PWD"
        if [[ -n $TMUX && -z $TMUX_PANE ]]; then
            IFS=$'\t' read -r managed path < <(tmux display-message -p $'#{@tds_managed}\t#{session_path}')
            [[ "$managed" == "1" ]] && here="$path"
        fi
        listed=$(find "${SEARCH_PATHS[@]}" -mindepth 1 -maxdepth 1 -not -path '*/.*' -type d 2>/dev/null | sort)
        grep -qxF -- "$here" <<<"$listed" || mark="* "
        { echo "$here"; grep -vxF -- "$here" <<<"$listed"; } | project_rows short |
            awk -F'\t' -v p="$here" -v m="$mark" 'BEGIN { OFS = "\t" } $1 == p { $2 = m $2 } 1'
    }
    while true; do
        picked=$(list_projects | fzf --expect=ctrl-r,ctrl-p,ctrl-x \
            --no-sort \
            --delimiter=$'\t' \
            --with-nth=2.. \
            --border-label " 󰅍 $label_text " \
            --header "enter: open  ctrl-r: rebuild  ctrl-p: rebuild with profile  ctrl-x: kill session" \
            --prompt="󰝰 Project > ")
        key=$(head -n1 <<<"$picked")
        target=$(sed -n 2p <<<"$picked" | cut -f1)
        if [[ "$key" == "ctrl-x" && -n "$target" ]]; then
            kill_name=$(session_name_for "$target")
            if tmux list-sessions -f "$MANAGED_FILTER" -F '#{session_name}' | grep -qxF -- "$kill_name"; then
                tmux kill-session -t "=$kill_name"
            fi
            continue
        fi
        break
    done
    if [[ "$key" == "ctrl-r" || "$key" == "ctrl-p" ]]; then
        RECREATE=true
    fi
    if [[ "$key" == "ctrl-p" && -n "$target" ]]; then
        pick_profile "$(session_name_for "$target")" || { echo "Cancelled."; exit 0; }
    fi
    if [[ -z "$target" ]]; then
        echo "Cancelled."
        exit 0
    fi
elif [[ "$SESSIONS_MODE" == "true" ]]; then
    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is required for --sessions mode." >&2
        exit 1
    fi

    session_rows() {
        local rows current
        rows=$(tmux list-sessions -f "$MANAGED_FILTER" -F $'#{session_name}\t#{@tds_profile}\t#{session_path}\t#{session_activity}' 2>/dev/null | sort -t$'\t' -k4,4nr)
        [[ -n "$rows" ]] || return 0
        current=""
        [[ -n $TMUX ]] && current=$(tmux display-message -p '#S')
        local search_paths
        search_paths=$(IFS='|'; echo "${SEARCH_PATHS[*]}")
        awk -F'\t' -v c="$current" -v sp="$search_paths" -v home="$HOME" -v now="$(date +%s)" '
            function base(p,   n, parts) { n = split(p, parts, "/"); return parts[n] }
            function shorten(p) { return index(p, home "/") == 1 ? "~/" substr(p, length(home) + 2) : p }
            function is_project(p,   parent) { parent = p; sub(/\/[^\/]*$/, "", parent); return parent in sp_set }
            function age(t,   d) {
                d = now - t
                if (d < 60) return "just now"
                if (d < 3600) return int(d / 60) "m ago"
                if (d < 86400) return int(d / 3600) "h ago"
                return int(d / 86400) "d ago"
            }
            BEGIN { n = split(sp, list, "|"); for (i = 1; i <= n; i++) sp_set[list[i]] = 1 }
            { rows[++total] = $0 }
            END {
                for (pass = 0; pass < 2; pass++)
                    for (i = 1; i <= total; i++) {
                        split(rows[i], f, "\t")
                        if ((pass == 0) != (f[1] == c)) continue
                        proj = is_project(f[3]) ? base(f[3]) : shorten(f[3])
                        printf "%s\t%s   [session: %s | profile: %s | %s]\n", f[1], proj, f[1], f[2], age(f[4])
                    }
            }
        ' <<<"$rows"
    }

    while true; do
        picked=$(session_rows | fzf --expect=ctrl-r,ctrl-p,ctrl-x \
            --delimiter=$'\t' \
            --with-nth=2.. \
            --prompt="󰖯 Session > " \
            --border-label " 󰖲 Sessions " \
            --header "enter: switch  ctrl-r: recreate  ctrl-p: recreate with profile  ctrl-x: kill")
        key=$(head -n1 <<<"$picked")
        session_pick=$(sed -n 2p <<<"$picked" | cut -f1)
        if [[ "$key" == "ctrl-x" && -n "$session_pick" ]]; then
            tmux kill-session -t "=$session_pick"
            continue
        fi
        break
    done
    if [[ -z "$session_pick" ]]; then
        echo "Cancelled."
        exit 0
    fi

    if [[ "$key" == "ctrl-r" || "$key" == "ctrl-p" ]]; then
        RECREATE=true
        if [[ "$key" == "ctrl-p" ]]; then
            pick_profile "$session_pick" || { echo "Cancelled."; exit 0; }
        fi
        target=$(tmux display-message -p -t "=$session_pick:" '#{session_path}')
    else
        if [[ -n $TMUX ]]; then
            tmux switch-client -t "=$session_pick"
        else
            tmux attach-session -t "=$session_pick"
        fi
        exit 0
    fi
elif [[ "$YAZI_MODE" == "true" ]]; then
    if ! command -v yazi &>/dev/null; then
        echo "Error: yazi is required for --yazi mode." >&2
        exit 1
    fi
    tmp="$(mktemp -t "tds.XXXXXX")"
    yazi --cwd-file="$tmp"

    target=""
    if [[ -f "$tmp" ]]; then
        target="$(cat -- "$tmp")"
        rm -f -- "$tmp"
    fi

    if [[ -z "$target" ]]; then
        echo "Cancelled."
        exit 0
    fi
elif [[ -z "$target" ]]; then
    # Default behavior: use current directory
    target="$PWD"
fi

if [[ -n "$target" ]]; then
    if [[ -d "$target" ]]; then
        selected="$(cd "$target" && pwd)"
        add_to_history "$selected"
    else
        echo "Error: Directory '$target' not found." >&2
        exit 1
    fi
else
    selected="$PWD"
    add_to_history "$selected"
fi

selected_name=$(session_name_for "$selected")
if [[ "$PROFILE_PICK" == "true" && "$PROFILE_EXPLICITLY_SET" != "true" ]]; then
    RECREATE=true
    pick_profile "$selected_name" || { echo "Cancelled."; exit 0; }
fi
tmux_running=$(pgrep tmux)

# --- Dynamic Session & Window Builder (Profile or 1-Window Fallback) ---
build_session() {
    local session="$1"
    local dir="$2"
    local profile="$3"
    local profile_label="basic"

    if [[ -n "$profile" && -f "$profile" ]]; then
        profile_label=$(basename "$profile" .json)
        local win_count
        win_count=$(jq '.windows | length' "$profile")

        for ((i = 0; i < win_count; i++)); do
            local w_name w_cmd
            w_name=$(jq -r --argjson idx "$i" '.windows[$idx].name' "$profile")
            w_cmd=$(jq -r --argjson idx "$i" '.windows[$idx].command' "$profile")

            if [[ $i -eq 0 ]]; then
                if [[ -n "$w_cmd" ]]; then
                    tmux new-session -d -s "$session" -c "$dir" -n "$w_name" "$w_cmd"
                else
                    tmux new-session -d -s "$session" -c "$dir" -n "$w_name"
                fi
            else
                if [[ -n "$w_cmd" ]]; then
                    tmux new-window -t "$session:$((i + 1))" -n "$w_name" -c "$dir" "$w_cmd"
                else
                    tmux new-window -t "$session:$((i + 1))" -n "$w_name" -c "$dir"
                fi
            fi
        done
    else
        # Fallback: 1 default window named "Terminal" (plain shell)
        tmux new-session -d -s "$session" -c "$dir" -n "󰞷 Terminal"
    fi

    tmux set-option -t "$session:" @tds_profile "$profile_label"
    tmux set-option -t "$session:" @tds_managed 1
    tmux select-window -t "$session:1"

    if [[ -n "$EDITOR_CMD" ]]; then
        setsid "$EDITOR_CMD" "$dir" >/dev/null 2>&1 &
        sleep 0.2
    fi
}

# --- Tmux Session Logic ---
# Case A: If we aren't in tmux and it's not even running, start fresh and attach
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    build_session "$selected_name" "$selected" "$PROFILE_FILE"
    tmux attach-session -t "$selected_name"
    exit 0
fi

# Recreate: drop the existing session so the profile is rebuilt
if [[ "$RECREATE" == "true" ]] && tmux has-session -t="$selected_name" 2>/dev/null; then
    if [[ "$NO_PROFILE" != "true" && "$PROFILE_EXPLICITLY_SET" != "true" ]]; then
        current_profile=$(tmux display-message -p -t "=$selected_name:" '#{@tds_profile}')
        if [[ "$current_profile" == "basic" ]]; then
            PROFILE_FILE=""
        elif [[ -n "$current_profile" ]]; then
            if [[ -f "$PROFILES_DIR/$current_profile.json" ]] && profile_is_valid "$PROFILES_DIR/$current_profile.json"; then
                PROFILE_FILE="$PROFILES_DIR/$current_profile.json"
            else
                echo "Warning: session profile '$current_profile' is missing or invalid; using the default profile." >&2
            fi
        fi
    fi
    if [[ -n $TMUX ]] && [[ "$(tmux display-message -p '#S')" == "$selected_name" ]]; then
        rebuild_name="$selected_name-rebuild"
        old_name="$selected_name-old"
        build_session "$rebuild_name" "$selected" "$PROFILE_FILE"
        tmux switch-client -t "$rebuild_name:"
        tmux rename-session -t "$selected_name:" "$old_name"
        tmux rename-session -t "$rebuild_name:" "$selected_name"
        tmux kill-session -t "$old_name:"
        exit 0
    fi
    tmux kill-session -t "=$selected_name"
fi

# Case B: Create the session in the background if it doesn't exist yet
if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    build_session "$selected_name" "$selected" "$PROFILE_FILE"
fi

# Case C: Switch or Attach
if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
