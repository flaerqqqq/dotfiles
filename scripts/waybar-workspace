#!/usr/bin/env bash
# waybar-workspace N
# Waybar custom module for workspace N. Prints one JSON line now and again on
# every Hyprland workspace/window event. Replaces waybar's hyprland/workspaces
# because that module sends legacy "dispatch workspace N", which Hyprland's Lua
# config rejects (clicks did nothing). Clicks are handled by waybar on-click.
# Requires: hyprctl, jq, socat.

set -uo pipefail

n="${1:?usage: waybar-workspace N}"
sock="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

emit() {
    local mons wins cls="inactive"
    mons=$(hyprctl -j monitors 2>/dev/null | sed -n '/^[[{]/,$p')
    wins=$(hyprctl -j workspaces 2>/dev/null | sed -n '/^[[{]/,$p')
    if [ "$(printf '%s' "$mons" | jq -r --argjson n "$n" '[.[] | select(.focused and .activeWorkspace.id == $n)] | length' 2>/dev/null)" = "1" ]; then
        cls="active"
    elif [ "$(printf '%s' "$mons" | jq -r --argjson n "$n" '[.[] | select(.activeWorkspace.id == $n)] | length' 2>/dev/null)" = "1" ]; then
        cls="visible"
    elif [ "$(printf '%s' "$wins" | jq -r --argjson n "$n" '[.[] | select(.id == $n and .windows > 0)] | length' 2>/dev/null)" = "1" ]; then
        cls="occupied"
    fi
    printf '{"text":"%s","class":"%s"}\n' "$n" "$cls"
}

emit
socat -u "UNIX-CONNECT:$sock" - | while read -r line; do
    case "$line" in
    workspace*|focusedmon*|createworkspace*|destroyworkspace*|moveworkspace*|openwindow*|closewindow*|movewindow*) emit ;;
    esac
done
